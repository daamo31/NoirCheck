# ==========================================
# NOIRCHECK BACKEND CONFIGURATION
# ==========================================

# Configuración de la aplicación
DEBUG=True
LOG_LEVEL=INFO
APP_NAME=NoirCheck
APP_VERSION=1.0.0

# Base de datos
DATABASE_URL=sqlite:///./noircheck.db
# Para PostgreSQL: postgresql://user:password@localhost/noircheck
# Para MySQL: mysql://user:password@localhost/noircheck

# Seguridad y autenticación
SECRET_KEY=your_secret_key_here_change_in_production_use_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# XION Blockchain Configuration (simulated for development)
XION_API_KEY=your_xion_api_key_here
XION_BASE_URL=https://api.xion.network
XION_NETWORK=testnet
XION_TIMEOUT=30

# Configuración de archivos
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,bmp,webp,tiff,mp4,avi,mov,mkv,webm,pdf,txt,doc,docx
ENABLE_FILE_COMPRESSION=True
AUTO_CLEANUP_DAYS=30

# Configuración de servidor
HOST=0.0.0.0
PORT=8000
WORKERS=1
RELOAD=True

# CORS configuration
CORS_ORIGINS=*
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=*

# Cache configuration
ENABLE_CACHE=True
CACHE_TTL=3600
REDIS_URL=redis://localhost:6379/0

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Logging
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE=./logs/noircheck.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# Monitoring
ENABLE_METRICS=True
METRICS_PORT=9090

# Email configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@noircheck.app

# External services (optional)
WEBHOOK_URL=https://your-webhook-url.com/notify
NOTIFICATION_SERVICE_API_KEY=your_notification_api_key

# Development settings
ENABLE_SWAGGER=True
ENABLE_REDOC=True
ENABLE_PROFILING=False
